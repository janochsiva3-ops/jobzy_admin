# ==============================================================================
# JobZy Admin App - .gitignore
# ==============================================================================

# 1. Environment & Sensitive Credentials (DO NOT COMMIT SECRETS)
.env
.env*
!.env.example
*.pem
*.key
*.cert

# 2. Database Files (Local caches / SQLite databases)
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# 3. Dependencies
/node_modules
/.pnp
.pnp.js

# 4. Next.js Build Outputs & Caches
/.next/
/out/
/build
.vercel
*.tsbuildinfo
next-env.d.ts

# 5. User Uploads / Temporary Assets
public/uploads/*
!public/uploads/.gitkeep

# 6. Testing & Coverage
/coverage

# 7. Debug & Log Files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 8. OS & System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# 9. IDE & Editor Configs
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
