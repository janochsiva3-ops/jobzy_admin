# ==============================================================================
# JobZy Admin App - Environment Variables Template
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# Supabase Project Credentials
SUPABASE_ACCESS_TOKEN=your_supabase_personal_access_token_here
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# PostgreSQL Database Connection Strings (Supabase Pooler)
DATABASE_URL=postgresql://postgres.your-project-id:your_db_password@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
DIRECT_URL=postgresql://postgres.your-project-id:your_db_password@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

